# Hope Beacon on plain Postgres: the settings. `npm run keys -- --write` (in
# selfhost/server) copies this file to selfhost/.env with the five secrets
# filled in. Then fill in the rest by hand. Never commit selfhost/.env.

# --- Secrets, made by `npm run keys` -------------------------------------------
# JWT_SECRET signs every sign-in: whoever has it can be anybody. Keep it on the
# server. ANON_KEY is public (the app sends it from every browser).
# SERVICE_ROLE_KEY passes every row rule: it must never leave the server.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=

# --- Addresses ------------------------------------------------------------------
# Where people open the app. E-mailed links go here.
SITE_URL=https://beacon.example.org
# Where the app reaches this server (the app's NEXT_PUBLIC_SUPABASE_URL).
PUBLIC_URL=https://api.beacon.example.org
# For the https profile: the two names above, without https://.
APP_DOMAIN=beacon.example.org
API_DOMAIN=api.beacon.example.org
# Behind the https profile or another proxy you run: true, so sign-in limits
# count each person's address rather than the proxy's.
TRUST_PROXY=true
# Other addresses the app is opened from, comma-separated (optional).
ALLOWED_ORIGINS=
# The app's own functions check the caller's address too (same value as SITE_URL).
BEACON_ALLOWED_ORIGINS=https://beacon.example.org

# --- E-mail (invitations and password resets) ----------------------------------
# Any SMTP account works: Brevo, Mailgun, Postmark, Google Workspace, your host's.
# Without these, messages are written to the server's outbox folder instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Hope Beacon"

# --- Optional -------------------------------------------------------------------
# Phone notifications: `npx web-push generate-vapid-keys` makes a pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
# Signing yourself up stays closed: people arrive by invitation.
ENABLE_SIGNUP=false
# How long e-mailed links last, in seconds.
INVITE_LINK_EXPIRY=86400
RECOVERY_LINK_EXPIRY=3600
