# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/.next-dev/
/out/
/.vercel/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — never commit real keys
#
# Ignore EVERY .env variant and allow back only the example. An earlier list
# named `.env`, `.env.local` and `.env*.local` one by one, which left
# `.env.production` tracked — exactly the name somebody reaches for when they
# are setting a deployment up and in a hurry.
.env
.env.*
!.env.example

# editor
.vscode/
.idea/

# Build artifact — regenerated on every typecheck.
tsconfig.tsbuildinfo

# Anything a contributor keeps beside the project but should never publish:
# scratch notes, exports, a local copy of somebody's real data.
/private/
/scratch/
/.ui-check/

# Generated handbooks (build output)
docs/handbook/*.docx
docs/handbook/*.pdf
docs/handbook/node_modules/
docs/handbook/package*.json

# Local environment files — never commit keys
.env.local
.env*.local

# Generated guides. The Markdown in docs/ is the source; these are built from it
# with `node docs/handbook/build-pdf.js`. Committing them would give the repo two
# copies of every guide that drift apart, and the PDF is always the stale one.
docs/handbook/pdf/

# The Supabase CLI's scratch directory. Holds the CLI version it last saw and
# nothing anybody wrote; it appears the first time you run the CLI and is not
# part of the project.
supabase/.temp/

# The drawing board's fonts, copied from node_modules before every build by
# scripts/excalidraw-assets.mjs. Generated, and the package is the source.
/public/excalidraw/

# A developer's own Claude Code settings: which plugins they turned on or off for
# this project. Personal, and never shared (docs/DEVELOPER-TOOLKIT.md).
/.claude/settings.local.json
