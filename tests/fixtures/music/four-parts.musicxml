      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><lyric number="1"><text>a-</text></lyric></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice><lyric number="1"><text>rise!</text></lyric></note>
