# Copy to .env.local and fill in from your own Supabase project:
#   Project Settings -> API
#
# Leave this file empty and the app runs on sample data in your browser, which
# is the fastest way to see what it does. Nothing here is a secret: the anon key
# ships to every visitor's browser by design, and row level security is what
# protects your data. See supabase/migrations/0001_core_schema.sql.
#
# NEVER put the service_role key in this file or anywhere with NEXT_PUBLIC_ in
# the name. That key bypasses every security policy in the database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required before a live build. Public facts: no credentials belong here.
NEXT_PUBLIC_BEACON_CONTROLLER=
NEXT_PUBLIC_BEACON_PRIVACY_CONTACT=
NEXT_PUBLIC_BEACON_HOSTING_DETAILS=
