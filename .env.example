# Copy to .env.local and fill in from your own Supabase project:
#   Project Settings -> API
#
# Leave this file empty and the app runs on sample data in your browser, which
# is the fastest way to see what it does. Nothing here is a secret: the anon key
# ships to every visitor's browser by design, and row level security is what
# protects your data. See supabase/migrations/0001_core_schema.sql.
#
# NEVER put the service_role key in this file or anywhere with NEXT_PUBLIC_ in
# the name. That key bypasses every security policy in the database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which Adventist organisations Home's "Church & Mission Updates" starts
# with, as a comma-separated list of ids from lib/updates/organisations.ts
# (for example: slpum,ssd,gc). Each person can change their own list. Left
# empty, Home starts with gc, ssd, spd and iad.
NEXT_PUBLIC_UPDATES_FEATURED=

# Apps and study sites your church recommends, shown as Discover cards in their
# own section on Home (apps only: news belongs to Church & Mission Updates). One per line or separated by semicolons, each written as
#   Title | https://address | One line about it
# Only https addresses the Pocket would accept are shown. Each person can skip
# a card (x) or keep it in their Pocket. Left empty, Discover is not shown.
# This project recommends no apps of its own.
NEXT_PUBLIC_DISCOVER_LINKS=
